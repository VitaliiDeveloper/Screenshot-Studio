{
  "name": "@screenshot-studio/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Code-first App Store and Google Play screenshot editor and exporter",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitaliiDeveloper/Screenshot-Studio.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/VitaliiDeveloper/Screenshot-Studio#readme",
  "bugs": {
    "url": "https://github.com/VitaliiDeveloper/Screenshot-Studio/issues"
  },
  "keywords": [
    "app-store",
    "google-play",
    "screenshots",
    "cli",
    "editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "screenshots": "./src/index.ts"
  },
  "exports": {
    "./export": "./src/export.ts",
    "./font-service": "./src/font-service.ts",
    "./theme-service": "./src/theme-service.ts",
    "./template-service": "./src/template-service.ts",
    "./render-driver": "./src/render-driver.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@screenshot-studio/core": "workspace:*",
    "jszip": "^3.10.1",
    "playwright": "1.61.1",
    "sharp": "0.34.5"
  }
}
